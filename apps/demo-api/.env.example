# Demo API — local development
# Copy to `.env` and adjust if needed. `.env` is git-ignored.

PORT=8787

# Local SQLite file (resolved against apps/demo-api).
# In production use the Turso libSQL URL, e.g. libsql://<db>-<org>.turso.io
TURSO_DATABASE_URL=file:./data/dev.db

# Required only for a hosted Turso database.
TURSO_AUTH_TOKEN=

# Comma-separated browser origins. Use * only for local experiments.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Write requests allowed per IP per minute.
RATE_LIMIT_MAX=120
