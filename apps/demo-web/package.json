    "@syncraft-labs/vue": "0.8.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitejs/plugin-vue": "^6.0.11",
    "typescript": "^5.8.0",
    "vite": "^7.3.8",
    "vue-tsc": "^3.3.14"
  },
  "engines": {
    "node": ">=24.0.0"
