# Demo web — local development
# Copy to `.env.local` when the API is not behind the Vite proxy.
#
# Leave empty for `npm run dev` (the Vite proxy forwards /api and /health to
# http://127.0.0.1:8787). In production this must be the Render API origin,
# for example https://syncraft-demo-api.onrender.com
VITE_API_URL=
