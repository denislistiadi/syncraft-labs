{
  "name": "syncraft-labs",
  "version": "0.9.0-beta.1",
  "private": true,
  "description": "Local-First state synchronization engine for React and Vue.",
  "homepage": "https://syncraft-labs.web.id",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "demo:dev": "turbo run dev --filter=./apps/demo-*",
    "demo:build": "turbo run build --filter=./apps/demo-*",
    "demo:test": "turbo run test --filter=./apps/demo-*",
    "demo:e2e": "npm run test:e2e --workspace @syncraft-labs/demo-web",
    "demo:e2e:live": "npm run test:e2e:live --workspace @syncraft-labs/demo-web",
    "demo:smoke:live": "npm run smoke:live --workspace @syncraft-labs/demo-web",
    "demo:typecheck": "turbo run typecheck --filter=./apps/demo-*",
    "release:check": "node scripts/check-versions.mjs",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "npm@10.0.0"
}
